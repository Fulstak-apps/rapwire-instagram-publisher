{
  "name": "rapwire-instagram-publisher",
  "private": true,
  "type": "module",
  "scripts": {
    "publish": "python scripts/convert-media-to-jpeg.py && node scripts/publish-instagram.mjs",
    "mirror:login": "node scripts/instagram-browser-mirror.mjs login",
    "mirror:capture": "node scripts/instagram-browser-mirror.mjs capture",
    "mirror:draft": "node scripts/instagram-browser-mirror.mjs draft",
    "mirror:publish": "node scripts/instagram-browser-mirror.mjs publish",
    "repost:monitor": "node scripts/instagram-repost-monitor.mjs",
    "report": "node scripts/publisher-report.mjs",
    "threads:engage": "node scripts/threads-engage.mjs",
    "threads:hourly": "node scripts/hourly-threads.mjs",
    "repost:install": "bash scripts/install-repost-monitor.sh"
  },
  "dependencies": {
    "playwright-core": "^1.55.0"
  },
  "engines": {
    "node": ">=20"
  }
}
