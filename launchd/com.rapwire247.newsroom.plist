<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.rapwire247.newsroom</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>exec "$HOME/Library/Application Support/RapWire/publisher-runtime/scripts/run-local-newsroom.sh"</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>300</integer>
  <key>StandardOutPath</key><string>/tmp/rapwire247-newsroom.out.log</string>
  <key>StandardErrorPath</key><string>/tmp/rapwire247-newsroom.err.log</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
